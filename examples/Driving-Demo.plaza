Font": "Gotham", "Text": "\u25b6", "AnchorPoint": {"X": 0, "Y": 1}, "Position": {"XS": 0, "XO": 134, "YS": 1, "YO": -22}, "Size": {"XS": 0, "XO": 100, "YS": 0, "YO": 100}, "BackgroundColor3": {"R": 0.07, "G": 0.08, "B": 0.11}, "BackgroundTransparency": 0.35, "TextSize": 44, "TextColor3": {"R": 1, "G": 1, "B": 1}}, "K": [{"C": "UICorner", "N": "UICorner", "P": {"CornerRadius": 24}, "K": []}, {"C": "UIStroke", "N": "UIStroke", "P": {"Color": {"R": 0.2, "G": 0.9, "B": 1}, "Thickness": 2, "Transparency": 0.2}, "K": []}]}, {"C": "TextButton", "N": "Gas", "P": {"Font": "Gotham", "Text": "GAS", "AnchorPoint": {"X": 1, "Y": 1}, "Position": {"XS": 1, "XO": -22, "YS": 1, "YO": -22}, "Size": {"XS": 0, "XO": 112, "YS": 0, "YO": 150}, "BackgroundColor3": {"R": 0.1, "G": 0.6, "B": 0.3}, "BackgroundTransparency": 0.35, "TextSize": 26, "TextColor3": {"R": 1, "G": 1, "B": 1}}, "K": [{"C": "UICorner", "N": "UICorner", "P": {"CornerRadius": 24}, "K": []}, {"C": "UIStroke", "N": "UIStroke", "P": {"Color": {"R": 0.4, "G": 1, "B": 0.6}, "Thickness": 2, "Transparency": 0.2}, "K": []}]}, {"C": "TextButton", "N": "Brake", "P": {"Font": "Gotham", "Text": "BRAKE", "AnchorPoint": {"X": 1, "Y": 1}, "Position": {"XS": 1, "XO": -146, "YS": 1, "YO": -22}, "Size": {"XS": 0, "XO": 100, "YS": 0, "YO": 100}, "BackgroundColor3": {"R": 0.8, "G": 0.15, "B": 0.2}, "BackgroundTransparency": 0.35, "TextSize": 18, "TextColor3": {"R": 1, "G": 1, "B": 1}}, "K": [{"C": "UICorner", "N": "UICorner", "P": {"CornerRadius": 24}, "K": []}, {"C": "UIStroke", "N": "UIStroke", "P": {"Color": {"R": 1, "G": 0.5, "B": 0.5}, "Thickness": 2, "Transparency": 0.2}, "K": []}]}, {"C": "TextButton", "N": "Nitro", "P": {"Font": "Gotham", "Text": "NITRO", "AnchorPoint": {"X": 1, "Y": 1}, "Position": {"XS": 1, "XO": -22, "YS": 1, "YO": -182}, "Size": {"XS": 0, "XO": 112, "YS": 0, "YO": 64}, "BackgroundColor3": {"R": 0.95, "G": 0.5, "B": 0.1}, "BackgroundTransparency": 0.35, "TextSize": 20, "TextColor3": {"R": 1, "G": 1, "B": 1}}, "K": [{"C": "UICorner", "N": "UICorner", "P": {"CornerRadius": 24}, "K": []}, {"C": "UIStroke", "N": "UIStroke", "P": {"Color": {"R": 1, "G": 0.8, "B": 0.3}, "Thickness": 2, "Transparency": 0.2}, "K": []}]}, {"C": "TextButton", "N": "Reset", "P": {"Font": "Gotham", "Text": "\u21bb", "AnchorPoint": {"X": 1, "Y": 0}, "Position": {"XS": 1, "XO": -16, "YS": 0, "YO": 16}, "Size": {"XS": 0, "XO": 56, "YS": 0, "YO": 56}, "BackgroundColor3": {"R": 0.07, "G": 0.08, "B": 0.11}, "BackgroundTransparency": 0.35, "TextSize": 30, "TextColor3": {"R": 1, "G": 1, "B": 1}}, "K": [{"C": "UICorner", "N": "UICorner", "P": {"CornerRadius": 24}, "K": []}, {"C": "UIStroke", "N": "UIStroke", "P": {"Color": {"R": 0.2, "G": 0.9, "B": 1}, "Thickness": 2, "Transparency": 0.2}, "K": []}]}, {"C": "LocalScript", "N": "CarController", "P": {"Source": "-- Driving HUD + touch controls. The car itself is driven by the engine (VehicleSeat \"Chassis\" inside Model \"Car\").\nlocal UIS = game:GetService(\"UserInputService\")\nlocal RS = game:GetService(\"RunService\")\nlocal gui = script.Parent\nlocal hud = gui.SpeedFrame\nlocal steer = 0\nlocal thr = 0\nlocal function apply()\n  UIS.ExtraSteer = steer\n  UIS.ExtraThrottle = thr\nend\nlocal function bind(btn, onDown, onUp)\n  btn.MouseButton1Down:Connect(function() onDown() btn.BackgroundTransparency = 0 end)\n  btn.MouseButton1Up:Connect(function() onUp() btn.BackgroundTransparency = .35 end)\nend\nbind(gui.Left,  function() steer = -1 apply() end, function() steer = 0 apply() end)\nbind(gui.Right, function() steer = 1 apply() end,  function() steer = 0 apply() end)\nbind(gui.Gas,   function() thr = 1 apply() end,    function() thr = 0 apply() end)\nbind(gui.Brake, function() thr = -1 apply() end,   function() thr = 0 apply() end)\nbind(gui.Nitro, function() UIS.Boost = true end,   function() UIS.Boost = false end)\ngui.Reset.MouseButton1Click:Connect(function() UIS.Respawn = true end)\nRS.Heartbeat:Connect(function()\n  local f = UIS.SpeedFraction\n  hud.SpeedText.Text = tostring(math.floor(UIS.Speed + 0.5))\n  hud.GearText.Text = UIS.Gear\n  local bar = hud.RpmBack.RpmBar\n  bar.Size = UDim2.new(f, 0, 1, 0)\n  bar.BackgroundColor3 = Color3.fromRGB(math.floor(60 + 195 * f), math.floor(220 - 150 * f), 90)\nend)\n"}, "K": []}]}]}]}